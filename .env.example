# ---- Gemini (pick one) ----
# Vertex AI (recommended on Cloud Shell):
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# or a Gemini API key (GOOGLE_CLOUD_PROJECT is still needed for BigQuery and Application Integration):
# GOOGLE_API_KEY=your-key
# LAUNCHKIT_MODEL=gemini-2.5-flash

# ---- BigQuery (the data) ----
BQ_DATASET=launchkit
BQ_LOCATION=US

# ---- Application Integration (purchase order, depot transfer, executive sign-off, launch update) ----
APP_INTEGRATION_NAME=launchkit-workflows
APP_INTEGRATION_LOCATION=us-central1

# ---- Service account the deployed agent runs as (needs BigQuery, Application Integration and Vertex AI
# access). Empty: Agent Engine's default service agent.
AGENT_SERVICE_ACCOUNT=app-svc-custom-sandbox@gebu-demo-sandbox.iam.gserviceaccount.com

# ---- Sign-off and tracking emails: "Role=a@x.com,b@x.com;Other Role=c@x.com" (a bare address = every role).
# Roles: "VP Product Marketing", "CMO" (sign-off) and "Launch Team" (tracking updates).
# Stored in the BigQuery table `approvers` by scripts/setup_all.py.
# APPROVER_EMAILS=VP Product Marketing=vp@example.com;CMO=cmo@example.com;Launch Team=team@example.com,team2@example.com

# ---- Written by scripts/deploy_agent_engine.py after deployment (used by scripts/query_agent_engine.py) ----
# AGENT_ENGINE_RESOURCE=projects/<project-number>/locations/us-central1/reasoningEngines/<id>

# ---- Private Cloud Storage bucket that hands the order pack PDF to the email workflow (no links are sent).
# Created by scripts/setup_order_pack_bucket.py, which also writes this line into .env. Default: <project>-launchkit-order-packs
ORDER_PACK_BUCKET=gebu-demo-sandbox-launchkit-order-packs
