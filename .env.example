# ---- Gemini (pick one) ----
# Vertex AI (recommended on Cloud Shell):
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# or a Gemini API key (GOOGLE_CLOUD_PROJECT is still needed for BigQuery and Application Integration):
# GOOGLE_API_KEY=your-key
# CAMPAIGN_MODEL=gemini-2.5-flash

# ---- BigQuery (the data) ----
BQ_DATASET=campaign_provisioner
BQ_LOCATION=US

# ---- Application Integration (purchase order + approver email workflow) ----
APP_INTEGRATION_NAME=campaign-provisioner-workflows
APP_INTEGRATION_LOCATION=us-central1

# ---- Approval notification emails: "Role=a@x.com,b@x.com;Other Role=c@x.com" (a bare address = every role).
# Stored in the BigQuery table `approvers` by scripts/setup_all.py.
# APPROVER_EMAILS=Marketing Director=md@example.com;VP Marketing + Finance Controller=vp@example.com,controller@example.com

# ---- Written by scripts/deploy_agent_engine.py after deployment (used by scripts/query_agent_engine.py) ----
# AGENT_ENGINE_RESOURCE=projects/<project-number>/locations/us-central1/reasoningEngines/<id>
