# ---- Model / auth (pick one) ----
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# or: GOOGLE_API_KEY=your-key   (then GOOGLE_CLOUD_PROJECT is still needed for BigQuery)
# CAMPAIGN_MODEL=gemini-2.5-flash

# ---- Data: bigquery (real) or memory (offline rehearsal) ----
DATA_BACKEND=bigquery
BQ_DATASET=campaign_provisioner
BQ_LOCATION=US

# ---- Workflow: app_integration (real) or mock (offline rehearsal) ----
WORKFLOW_BACKEND=app_integration
APP_INTEGRATION_NAME=campaign-provisioner-workflows
APP_INTEGRATION_LOCATION=us-central1
# APP_INTEGRATION_PO_TRIGGER=api_trigger/create_purchase_order
# APP_INTEGRATION_NOTIFY_TRIGGER=api_trigger/notify_approver

# ---- Approval notification emails: "Role=a@x.com,b@x.com;Other Role=c@x.com" (a bare address = every role).
# Stored in the BigQuery table `approvers` by scripts/setup_all.py / setup_bigquery.py.
# APPROVER_EMAILS=Marketing Director=md@example.com;VP Marketing + Finance Controller=vp@example.com,controller@example.com
